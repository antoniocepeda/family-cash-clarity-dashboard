NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase UID of the household owner. The agent API key acts as this user.
# If empty, the server uses the first NEXT_PUBLIC_AUTHORIZED_EMAILS address.
PUBLIC_DATA_OWNER_UID=

# Server-only key for the assistant. Leave unset to disable agent access.
# Send as Authorization: Bearer <key> or X-Agent-Key: <key>.
AGENT_API_KEY=

# Optional scheduler secret for POST /api/cron/sync (X-Cron-Key or Bearer).
# When unset, that route still accepts X-Agent-Key.
CRON_SECRET=

# Unauthenticated household reads. Off unless set to exactly "true".
ALLOW_PUBLIC_READ=

# Server-only Firebase Admin values for local development.
# On Firebase App Hosting/Cloud Run, prefer Application Default Credentials
# and set only FIREBASE_PROJECT_ID when needed.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server-only Plaid values, if Plaid sync routes are added/enabled.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
